{
  "version": 1,
  "space": "3d",
  "name": "chest3d",
  "palette_refs": [
    "palette.fart"
  ],
  "palette": [
    {
      "name": "wood",
      "rgb": [120, 90, 60, 255]
    },
    {
      "name": "clasp",
      "rgb": [170, 150, 90, 255]
    }
  ],
  "parts": [
    {
      "name": "box",
      "pivot": [0, 0, 0],
      "shapes": [
        {
          "kind": "mesh",
          "color": "wood",
          "points": [[-6, -1, -4], [6, -1, -4], [-6, 5, -4], [6, 5, -4], [-6, -1, 4], [6, -1, 4], [-6, 5, 4], [6, 5, 4]],
          "faces": [[2, 3, 1, 0], [4, 5, 7, 6], [0, 1, 5, 4], [6, 7, 3, 2], [4, 6, 2, 0], [1, 3, 7, 5]]
        }
      ]
    },
    {
      "name": "lid",
      "parent": "box",
      "pivot": [0, -1, 4],
      "shapes": [
        {
          "kind": "mesh",
          "color": "wood",
          "points": [[-6, -3, -4], [6, -3, -4], [-6, -1, -4], [6, -1, -4], [-6, -3, 4], [6, -3, 4], [-6, -1, 4], [6, -1, 4]],
          "faces": [[2, 3, 1, 0], [4, 5, 7, 6], [0, 1, 5, 4], [6, 7, 3, 2], [4, 6, 2, 0], [1, 3, 7, 5]],
          "shade": 1.1
        }
      ],
      "anchors": [
        {
          "name": "hinge",
          "at": [0, -1, 4],
          "dir": [1, 0, 0]
        }
      ]
    },
    {
      "name": "handle_r",
      "parent": "box",
      "pivot": [6, 2, 0],
      "shapes": [
        {
          "kind": "rod",
          "color": "clasp",
          "a": [6, 1, 0],
          "b": [7.5, 2, 0],
          "w": 0.5
        }
      ],
      "anchors": [
        {
          "name": "grip",
          "at": [7.5, 2, 0],
          "dir": [1, 0, 0]
        }
      ]
    },
    {
      "name": "handle_l",
      "like": "handle_r",
      "parent": "box",
      "pivot": [6, 2, 0]
    },
    {
      "name": "gem",
      "parent": "lid",
      "pivot": [0, -3, -4],
      "shapes": [
        {
          "kind": "ball",
          "color": "glow",
          "at": [0, -3, -4],
          "r": 0.6
        }
      ]
    }
  ],
  "states": [
    {
      "name": "closed",
      "parts": [
        {
          "part": "box"
        },
        {
          "part": "lid"
        },
        {
          "part": "gem"
        },
        {
          "part": "handle_r"
        },
        {
          "part": "handle_l",
          "mirror": true,
          "offset": [-6, 2, 0]
        }
      ]
    },
    {
      "name": "open",
      "parts": [
        {
          "part": "box"
        },
        {
          "part": "handle_r"
        },
        {
          "part": "handle_l",
          "mirror": true,
          "offset": [-6, 2, 0]
        },
        {
          "part": "lid",
          "rotate": [-2.2, 0, 0]
        },
        {
          "part": "gem"
        }
      ]
    }
  ],
  "clips": [
    {
      "name": "open",
      "keys": [
        {
          "t": 0,
          "state": "closed"
        },
        {
          "t": 0.4,
          "state": "open",
          "ease": "out",
          "events": [
            "creak"
          ]
        }
      ]
    }
  ],
  "collision": [
    {
      "kind": "mesh",
      "points": [[-6, -3, -4], [6, -3, -4], [-6, 5, -4], [6, 5, -4], [-6, -3, 4], [6, -3, 4], [-6, 5, 4], [6, 5, 4]],
      "faces": [[2, 3, 1, 0], [4, 5, 7, 6], [0, 1, 5, 4], [6, 7, 3, 2], [4, 6, 2, 0], [1, 3, 7, 5]]
    },
    {
      "kind": "ball",
      "at": [0, -3, -4],
      "r": 1
    }
  ],
  "meta": {
    "note": "a 3D corpus file"
  }
}
