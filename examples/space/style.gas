{
  "version": 1,
  "name": "space",
  "about": "A clean fleet in a dark sky: hard shapes, one shared hull palette, an engine glow; rocks and pickups are the exceptions and say so.",
  "roles": {
    "hull": "hull",
    "glow": "glow",
    "danger": "warn"
  },
  "scale": {
    "unit": "a metre",
    "sizes": {
      "ship": [
        10,
        40
      ],
      "rock": [
        6,
        30
      ]
    }
  },
  "shapes": {
    "kinds": [
      "poly",
      "line",
      "circle",
      "path"
    ],
    "budget": {
      "ship": 40,
      "*": 80
    }
  },
  "motion": {
    "ease": "in-out",
    "max": 2,
    "names": [
      "idle",
      "thrust"
    ]
  },
  "names": {
    "pattern": "^[a-z][a-z0-9_]*$"
  },
  "references": [
    {
      "file": "ships/fighter.fart",
      "for": "the standard ship: proportions, the thrust clip, the shared hull palette"
    },
    {
      "file": "rocks/asteroid_big.fart",
      "for": "a prop that is its own palette"
    }
  ],
  "rules": [],
  "avoid": [
    "gradients"
  ],
  "classes": {
    "ship": {
      "rules": [
        {
          "say": "every ship links the hull palette",
          "check": "palette.refs",
          "args": {
            "file": "palettes/hull.fart"
          }
        },
        {
          "say": "nothing is pure black in a ship",
          "check": "token.never",
          "args": {
            "rgb": [
              0,
              0,
              0
            ]
          }
        }
      ],
      "motion": {
        "max": 2
      }
    },
    "rock": {
      "motion": {
        "max": 4
      }
    },
    "texture": {
      "shapes": {
        "budget": {
          "texture": 40
        }
      }
    }
  }
}
