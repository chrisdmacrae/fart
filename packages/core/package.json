{
  "name": "@fastart/core",
  "version": "1.1.0",
  "description": "Fast Art Format (.fart): types, parsing, validation, palettes, posing, triangulation. Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "fart": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.17.0",
    "typescript": "^5.9.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4"
  }
}
